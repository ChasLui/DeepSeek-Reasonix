{
  "name": "reasonix",
  "version": "0.47.2",
  "description": "DeepSeek-native coding agent: cache-first loop, flash-first cost control, tool-call repair.",
  "type": "module",
  "bin": {
    "reasonix": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data/deepseek-tokenizer.json.gz",
    "dashboard/index.html",
    "dashboard/app.css",
    "dashboard/dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs && node scripts/copy-dashboard-vendor-css.mjs && node scripts/copy-tree-sitter-grammars.mjs",
    "dev": "tsx src/cli/index.ts",
    "chat": "tsx src/cli/index.ts chat",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "oxlint src tests dashboard/src desktop/src packages/core-utils/src --deny-warnings",
    "lint:fix": "oxlint src tests dashboard/src desktop/src packages/core-utils/src --fix",
    "format": "oxfmt src tests dashboard/src desktop/src packages/core-utils/src",
    "format:check": "oxfmt --check src tests dashboard/src desktop/src packages/core-utils/src",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p dashboard && tsgo --noEmit -p packages/core-utils && tsgo --noEmit -p desktop && npm run typecheck:declarations",
    "typecheck:declarations": "tsgo --noEmit -p dashboard/tsconfig.declaration.json && tsgo --noEmit -p desktop/tsconfig.declaration.json",
    "verify": "npm run build && npm run lint && npm run format:check && npm run typecheck && npm run transform:check && npm run test --silent",
    "transform:check": "node scripts/probe-oxc-transform.mjs",
    "prepare": "simple-git-hooks || true",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm run transform:check && npm run test && npm run build",
    "bench-shield": "tsx scripts/bench-mcp-shield.mts",
    "bench-daemon-warm": "tsx scripts/bench-daemon-warm.mts",
    "bench-daemon-cache": "tsx scripts/bench-daemon-token-cache.mts"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint",
    "pre-push": "npm run verify"
  },
  "keywords": [
    "agent",
    "llm",
    "deepseek",
    "r1",
    "tool-use",
    "prompt-cache",
    "cli",
    "tui"
  ],
  "author": "esengine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esengine/DeepSeek-Reasonix.git"
  },
  "bugs": {
    "url": "https://github.com/esengine/DeepSeek-Reasonix/issues"
  },
  "homepage": "https://github.com/esengine/DeepSeek-Reasonix#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "eventsource-parser": "^3.0.0",
    "ignore": "^7.0.5",
    "ink": "^7.0.2",
    "ink-text-input": "^6.0.0",
    "jsonrepair": "^3.14.0",
    "lru-cache": "^11.5.0",
    "node-html-parser": "^7.1.0",
    "picomatch": "^4.0.4",
    "react": "^19.2.6",
    "string-width": "^7.2.0",
    "undici": "^8.2.0",
    "web-tree-sitter": "^0.26.9",
    "ws": "^8.20.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260621.1",
    "@reasonix/core-utils": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.21.5",
    "highlight.js": "^11.10.0",
    "htm": "^3.1.1",
    "ink-testing-library": "^4.0.0",
    "marked": "^15.0.12",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "oxc-transform": "^0.137.0",
    "preact": "^10.22.0",
    "rolldown": "^1.1.2",
    "rolldown-plugin-dts": "^0.26.0",
    "simple-git-hooks": "^2.13.1",
    "strip-ansi": "^7.1.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "uplot": "^1.6.31",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^2.0.1"
  }
}
